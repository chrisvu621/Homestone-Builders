# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Public site URL (used for canonical URLs, sitemap and structured data).
# Leave unset on Vercel to fall back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Estimate form email delivery (server-only; never exposed to the browser) ---
# One of: resend | postmark | sendgrid
EMAIL_PROVIDER=
# Resend API key / Postmark server token / SendGrid API key
EMAIL_API_KEY=
# A sender address verified with your provider (domain must be verified)
EMAIL_FROM="Homestone Website <estimates@your-verified-domain.com>"
# Where estimate requests are delivered (comma-separated for multiple)
EMAIL_TO=

# --- Optional: Cloudflare Turnstile bot protection ---
# Set BOTH to enable. The site key is public; the secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
